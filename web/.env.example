# ==============================================================================
# LegalHelp Backend & Vercel Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI (Required for Legal Assistance)
# Obtain from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. MongoDB Atlas (Required for Lifetime Quota, Concurrency, and Circuit Breaker)
# Obtain from: https://cloud.mongodb.com/ (Create Free M0 Cluster -> Connect -> Drivers)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/legalhelp?retryWrites=true&w=majority
# ------------------------------------------------------------------------------
MONGODB_URI=

# ------------------------------------------------------------------------------
# 3. Clerk Authentication (Replaces Firebase)
# Obtain from: https://dashboard.clerk.com/ -> Select Application -> API Keys
# ------------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Optional JWT Key (if using custom signing key in Clerk dashboard)
CLERK_JWT_KEY=

# ------------------------------------------------------------------------------
# 4. Cloudinary (Required for PDF and Legal Document Storage & OCR)
# Obtain from: https://console.cloudinary.com/ -> Dashboard -> Product Environment Credentials
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 5. Free-Tier Quota Policies (Configurable Defaults)
# ------------------------------------------------------------------------------
FREE_MAX_CONVERSATIONS=3
FREE_MAX_QUERIES_PER_CONVERSATION=20
FREE_MAX_CHARACTERS_PER_QUERY=3000
FREE_MAX_FILES_PER_CONVERSATION=3
FREE_MAX_FILE_SIZE_MB=10

# ------------------------------------------------------------------------------
# 6. Global Gemini Rate & Concurrency Protection
# ------------------------------------------------------------------------------
GLOBAL_MAX_REQUESTS_PER_DAY=1000
GLOBAL_MAX_REQUESTS_PER_MINUTE=15
GLOBAL_MAX_OUTPUT_TOKENS=1000
GLOBAL_MAX_CONCURRENT_REQUESTS=3
CIRCUIT_BREAKER_COOLDOWN_MS=300000
